{
  "$schema": "./tokens.schema.json",
  "primitive": {
    "color": {
      "midnight": {
        "200": "#959cc6",
        "400": "#3a3f73",
        "500": "#262a52",
        "700": "#11132c",
        "800": "#0a0c1f",
        "900": "#06081a"
      },
      "champagne": {
        "0": "#fffdf8",
        "50": "#fff5e9"
      },
      "aurora": {
        "cyan": "#5eead4",
        "violet": "#a78bfa",
        "magenta": "#f0abfc"
      },
      "danger": {
        "300": "#fda4af",
        "700": "#9f1239"
      },
      "success": {
        "300": "#86efac",
        "700": "#15803d"
      }
    }
  },
  "semantic": {
    "color": {
      "light": {
        "bg": {
          "page": "{primitive.color.champagne.50}",
          "surface": "#fffaf2",
          "surface-sunk": "#fff7e88c",
          "surface-raised": "#fffbf5",
          "modal": "{primitive.color.champagne.0}",
          "overlay": "#5e34146b"
        },
        "text": {
          "primary": "{primitive.color.midnight.800}",
          "secondary": "{primitive.color.midnight.500}",
          "muted": "{primitive.color.midnight.400}",
          "accent": "{primitive.color.midnight.700}",
          "danger": "{primitive.color.danger.700}",
          "success": "{primitive.color.success.700}"
        },
        "border": {
          "subtle": "#5e341424",
          "default": "#5e34143d",
          "strong": "#5e34146b",
          "focus": "{primitive.color.midnight.700}"
        },
        "action": {
          "primary": {
            "bg": "#0a0c1feb",
            "bg-hover": "#0a0c1f",
            "bg-pressed": "#262a52",
            "fg": "{primitive.color.champagne.0}"
          },
          "secondary": {
            "bg": "#fffdf899",
            "bg-hover": "#fffdf8d9",
            "bg-pressed": "#feeacdd9",
            "fg": "{primitive.color.midnight.800}",
            "border": "#5e341433"
          },
          "danger": {
            "bg": "#e11d48",
            "bg-hover": "#f43f5e",
            "bg-pressed": "#9f1239",
            "fg": "{primitive.color.champagne.0}"
          }
        }
      },
      "dark": {
        "bg": {
          "page": "{primitive.color.midnight.900}",
          "surface": "#151728",
          "surface-sunk": "#06081a80",
          "surface-raised": "#1f2131",
          "modal": "{primitive.color.midnight.500}",
          "overlay": "#02030d9e"
        },
        "text": {
          "primary": "#f8f8f5f5",
          "secondary": "#f8f8f5b8",
          "muted": "#f8f8f580",
          "accent": "{primitive.color.aurora.cyan}",
          "danger": "{primitive.color.danger.300}",
          "success": "{primitive.color.success.300}"
        },
        "border": {
          "subtle": "#ffffff14",
          "default": "#ffffff29",
          "strong": "#ffffff52",
          "focus": "{primitive.color.aurora.cyan}"
        },
        "action": {
          "primary": {
            "bg": "#ffffffeb",
            "bg-hover": "#ffffff",
            "bg-pressed": "#cdd2e8e6",
            "fg": "{primitive.color.midnight.900}"
          },
          "secondary": {
            "bg": "#ffffff0f",
            "bg-hover": "#ffffff24",
            "bg-pressed": "#ffffff33",
            "fg": "#f8f8f5f5",
            "border": "#ffffff29"
          },
          "danger": {
            "bg": "#e11d48",
            "bg-hover": "#f43f5e",
            "bg-pressed": "#9f1239",
            "fg": "{primitive.color.champagne.0}"
          }
        }
      }
    }
  },
  "dichroic": {
    "glow": {
      "soft": "0 0 40px #a78bfa40, 0 0 80px #5eead42e"
    }
  },
  "atmosphere": {
    "vignette-light": "radial-gradient(ellipse at center, #fffdf800 0%, #feeacd2e 100%)",
    "vignette-dark": "radial-gradient(ellipse at center, #06081a00 0%, #02030d99 100%)"
  },
  "border": {
    "width": {
      "thin": "1px",
      "thick": "2px",
      "heavy": "3px"
    }
  },
  "opacity": {
    "disabled": "0.5"
  },
  "size": {
    "full": "100%",
    "viewport": "100vh",
    "content-max-width": "80%",
    "icon": "1em",
    "icon-lg": "1.25em",
    "surface": {
      "sm": "22.5rem",
      "md": "32rem",
      "lg": "54rem"
    },
    "grid-min-sm": "8rem",
    "grid-min-md": "16rem",
    "grid-min-lg": "24rem",
    "modal": {
      "max-width-vw": "92vw",
      "max-height": "85vh"
    },
    "control": {
      "sm": "1.875rem",
      "md": "2.5rem",
      "lg": "3rem"
    },
    "tap-target-min": "2.75rem"
  },
  "space": {
    "025": "0.125rem",
    "05": "0.25rem",
    "075": "0.375rem",
    "1": "0.5rem",
    "2": "1rem",
    "3": "1.5rem",
    "4": "2rem",
    "5": "2.5rem",
    "6": "3rem",
    "8": "4rem",
    "12": "6rem"
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.625rem",
    "lg": "0.875rem",
    "xl": "1.25rem",
    "2xl": "1.75rem",
    "full": "9999px"
  },
  "font": {
    "family": {
      "sans": "'Atkinson Hyperlegible', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "display": "'Bricolage Grotesque', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "md": "1.0625rem",
      "lg": "1.25rem",
      "xl": "1.5rem"
    },
    "weight": {
      "regular": "400",
      "semibold": "600"
    },
    "line-height": {
      "snug": "1.25",
      "normal": "1.5"
    }
  },
  "shadow": {
    "light": {
      "sm": "0 2px 6px -2px #5e34141f",
      "md": "0 8px 24px -8px #5e34142e, 0 2px 4px -2px #5e34141a",
      "lg": "0 20px 60px -16px #5e34144d, 0 8px 18px -10px #5e34142e"
    },
    "dark": {
      "sm": "0 2px 8px -2px #00000099",
      "md": "0 8px 32px -8px #000000b3, 0 2px 6px -2px #00000080",
      "lg": "0 24px 80px -16px #000000d9, 0 8px 24px -8px #0000008c"
    }
  },
  "motion": {
    "duration": {
      "fast": "160ms",
      "medium": "260ms",
      "slow": "640ms"
    },
    "bounce": "linear(0 0%, 1 38%, 0.94 47%, 1 57%, 0.98 78%, 1 88%, 1 100%)",
    "bounce-md": "linear(0 0%, 1 38%, 0.88 47%, 1 57%, 0.96 78%, 1 88%, 1 100%)",
    "bounce-scale": {
      "sm": {
        "out": "scale(1.2)",
        "out-2": "scale(1.06)"
      },
      "md": {
        "out": "scale(1.12)",
        "out-2": "scale(1.04)"
      },
      "lg": {
        "out": "scale(1.04)",
        "out-2": "scale(1.012)"
      }
    },
    "bounce-translate": {
      "out": "6px",
      "out-2": "2px"
    }
  },
  "z": {
    "base": "0",
    "raised": "10"
  }
}
